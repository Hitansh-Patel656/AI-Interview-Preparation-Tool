# backend/.env.example
#
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# This file is safe to commit — it contains only placeholder values.

# ─────────────────────────────────────────────
# MongoDB
# ─────────────────────────────────────────────
MONGO_URI=

# ─────────────────────────────────────────────
# Authentication (JWT)
# ─────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=1h
REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────────
# PostgreSQL
# Preferred: use DATABASE_URL (single connection string).
# Alternative: set the individual PG* variables below instead.
# ─────────────────────────────────────────────
DATABASE_URL=

# Individual variables (used only when DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# Set to "true" only when connecting to a remote/cloud PostgreSQL host.
DATABASE_SSL=false
